# Live events: Ticketmaster discovery API (https://developer.ticketmaster.com)
# Without it, Freakend falls back to curated experiences + the Madrid open data agenda + DondeGo.
TICKETMASTER_API_KEY=

# Optional: Google Places for live venues/photos near IE Madrid.
GOOGLE_PLACES_API_KEY=

# Optional: Spanish -> English event title/description translation.
# For production (Vercel) the unofficial Google browser endpoint is often blocked.
# Reliable options:
#   1. Google Cloud Translation API (official, free tier available):
#      TRANSLATION_API_URL=https://translation.googleapis.com/language/translate/v2
#      TRANSLATION_API_KEY=your_api_key
#   2. LibreTranslate self-hosted or with a key:
#      TRANSLATION_API_URL=https://your-libretranslate-instance/translate
#      TRANSLATION_API_KEY=your_key
# If nothing is configured, the app falls back to the free MyMemory API.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Optional: Unsplash API key for real event photos on Madrid CSV events.
# Without it, Madrid events fall back to deterministic random photos.
# Get a free key at https://unsplash.com/developers
UNSPLASH_API_KEY=

# Weather uses Open-Meteo (free, no key required).
# Events also pull from the Madrid open data agenda and DondeGo (free, no key required).
